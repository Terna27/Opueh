# Opueh frontend — local development defaults.
# Copy to .env.local and adjust. NEVER commit a real .env.local.
# This file must only ever contain placeholders, never real credentials.

# Origin of the Opueh Go API. No trailing slash.
# Must match the backend's ALLOWED_ORIGINS (see the repo-root .env.example);
# the backend's default CORS allowlist is http://localhost:3000, which is this
# app's dev origin.
#
# Server-side only, and deliberately NOT prefixed NEXT_PUBLIC_: the browser
# never calls the Go API. Every browser call goes to this app's own /api/auth/*
# routes, which hold the tokens in httpOnly cookies and attach the Bearer
# header upstream. The origin therefore never enters the client bundle.
API_BASE_URL=http://localhost:8080
