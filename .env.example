# Opueh backend — local development defaults.
# Copy to .env and adjust. NEVER commit a real .env.
# This file must only ever contain placeholders, never real credentials.

# local | staging | production
ENV=local

SERVICE_NAME=opueh-api

# debug | info | warn | error
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=30s

# Maximum accepted request body size (1 MiB default).
REQUEST_BODY_LIMIT_BYTES=1048576
# Tighter cap for /api/v1/auth/* payloads (auth JSON is tiny).
AUTH_BODY_LIMIT_BYTES=4096

# PostgreSQL connection string (use your real value in .env only).
DATABASE_URL=postgres://user:password@localhost:5432/opueh?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# Authentication.
# REQUIRED. Generate a strong secret with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-48-byte-base64-string
JWT_ISSUER=opueh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_TTL=720h

# Email verification & password recovery.
# APP_URL is the public frontend origin used to build links in emails.
APP_URL=http://localhost:3000
# dev | (a real provider can be wired later). "dev" logs emails to stdout
# and is ONLY allowed when ENV=local.
EMAIL_PROVIDER=dev
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
# Minimum time between verification/reset emails per user.
EMAIL_RESEND_COOLDOWN=1m
PASSWORD_RESET_COOLDOWN=1m
# Per-IP rate limit for POST /api/v1/auth/password/forgot.
PASSWORD_FORGOT_IP_LIMIT=10
PASSWORD_FORGOT_IP_WINDOW=1h

# Login brute-force protection. Limits apply per source IP and per account
# identifier; after LOGIN_MAX_FAILURES failures within LOGIN_FAILURE_WINDOW
# the account identifier is locked out for LOGIN_LOCKOUT_DURATION (never
# permanently — successful login resets the counters).
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# Readiness probe timeout for dependency checks.
READY_CHECK_TIMEOUT=2s
